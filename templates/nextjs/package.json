{
  "name": "relyingparty-app-nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build && wrangler deploy --dry-run --outdir dist",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "verify": "tsc -p tsconfig.worker.json && vitest run && opennextjs-cloudflare build && wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@comms-id/sign-in": "0.1.0",
    "@comms-id/sign-in-react": "0.1.0",
    "@opennextjs/cloudflare": "1.20.12",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
